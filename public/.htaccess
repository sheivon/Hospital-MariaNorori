# Redirect common error codes to a single friendly page
ErrorDocument 401 /error.php?code=401
ErrorDocument 404 /error.php?code=404
ErrorDocument 500 /error.php?code=500

# Redirect direct access of legacy error page filenames to the unified error page
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^401\.php$ /error.php?code=401 [R=302,L]
  RewriteRule ^404\.php$ /error.php?code=404 [R=302,L]
  RewriteRule ^500\.php$ /error.php?code=500 [R=302,L]
</IfModule>
